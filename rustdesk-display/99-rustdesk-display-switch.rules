# /etc/udev/rules.d/99-rustdesk-display-switch.rules
# Trigger auto HDMI ↔ headless switching.

# DRM hotplug events (works when real GPU is driving the display)
SUBSYSTEM=="drm", ACTION=="change", TAG+="systemd", ENV{SYSTEMD_WANTS}+="rustdesk-display-switch.service"

# USB display hub plug/unplug (works even when dummy driver is active)
# Anker 364 USB C Hub (10-in-1, Dual 4K HDMI)
SUBSYSTEM=="usb", ATTR{idVendor}=="291a", ATTR{idProduct}=="83a2", ACTION=="add", TAG+="systemd", ENV{SYSTEMD_WANTS}+="rustdesk-display-switch.service"
SUBSYSTEM=="usb", ATTR{idVendor}=="291a", ATTR{idProduct}=="83a2", ACTION=="remove", TAG+="systemd", ENV{SYSTEMD_WANTS}+="rustdesk-display-switch.service"
